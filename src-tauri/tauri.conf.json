{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winkit",
  "version": "../package.json",
  "identifier": "com.alejandrofont.winkit",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Alejandro Font",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "Herramientas para Windows con Claude",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMjQ5RkZDQjU3N0UxNUQKUldSZDRYZTEvSjhrK3hrRVpRWHdpUU54LytDZXBIYk9YNzFubUVpS2d3SHVCcU1GTTJVK0Z1NmIK",
      "endpoints": [
        "https://github.com/AleDev11/winkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
